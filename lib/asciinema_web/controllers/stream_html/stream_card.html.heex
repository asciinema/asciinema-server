<MediumHTML.card
  url={~p"/s/#{@stream}"}
  title={title(@stream)}
  theme={theme(@stream)}
  author_profile_url={author_profile_path(@stream)}
  author_username={author_username(@stream)}
  author_avatar_url={author_avatar_url(@stream)}
  no_play_overlay={@status != :live}
>
  <:preview>
    <%= if @status == :live do %>
      <RecordingSVG.thumbnail asciicast={@stream} />
    <% else %>
      <.countdown status={@status} />
    <% end %>
  </:preview>

  <:duration :if={@status == :live}>
    <.live_icon />
  </:duration>

  <:schedule :if={match?({:waiting, _}, @status)}>
    <time datetime={DateTime.to_iso8601(@stream.next_start_at)}>
      Scheduled for {format_start_time(@stream)}
    </time>
  </:schedule>

  <:badges>
    <.visibility_badge :if={@show_visibility_badge} visibility={@stream.visibility} />
  </:badges>
</MediumHTML.card>
