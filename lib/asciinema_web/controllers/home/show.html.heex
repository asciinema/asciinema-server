<section class="home-hero" aria-labelledby="home-title">
  <div class="container">
    <div class="hero-text">
      <h1 id="home-title">Record, stream, and share <span>your terminal.</span></h1>
      <p class="hero-intro">
        asciinema records terminal sessions as text, with the timing preserved.
        You can play them back in a terminal or browser. It does live streaming, too.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="https://docs.asciinema.org/getting-started/">
          Get started
        </a>
        <a href={~p"/explore"}>Explore recordings</a>
      </div>
      <p class="hero-note">Free and open source.</p>
    </div>

    <AsciinemaWeb.TerminalTheme.homepage />
    <figure class="home-demo">
      <div class="demo-frame">
        <div class="demo-heading">
          <span>Try the player</span>
        </div>
        <div class="player-wrapper" id="player"></div>
      </div>
      <figcaption>
        There's a terminal emulator in there, replaying the output, escape sequences and all.
        Skip around, pause to copy a command, or use browser zoom.
      </figcaption>
    </figure>
  </div>
</section>

<section class="home-toolkit" aria-labelledby="toolkit-title">
  <div class="container">
    <div class="home-section-intro">
      <h2 id="toolkit-title">A toolkit for terminal sessions.</h2>
      <p>
        The <code>asciinema</code>
        command-line tool (CLI) handles recording, playback in your terminal, and live streaming.
        The web player is for watching recordings and streams in a browser.
      </p>
    </div>
    <div class="features">
      <article>
        <header>
          <span class="feature-number" aria-hidden="true">01</span>
          <h3>Record and replay</h3>
        </header>
        <div class="feature-content">
          <p>
            Work in your terminal as usual. Save the session locally, then replay it
            in your terminal or a browser, with the original colors and timing.
          </p>
          <.code_with_copy>asciinema rec demo.cast</.code_with_copy>
          <a href="https://docs.asciinema.org/getting-started/#recording">Make your first recording</a>
        </div>
      </article>

      <article>
        <header>
          <span class="feature-number" aria-hidden="true">02</span>
          <h3>Share a recording</h3>
        </header>
        <div class="feature-content">
          <p>
            Upload to asciinema.org and send someone the link. Viewers can pause,
            seek, and copy text straight from the player.
          </p>
          <.code_with_copy>asciinema upload demo.cast</.code_with_copy>
          <a href="https://docs.asciinema.org/getting-started/#sharing">Share your session</a>
        </div>
      </article>

      <article>
        <header>
          <span class="feature-number" aria-hidden="true">03</span>
          <h3>Stream live</h3>
        </header>
        <div class="feature-content">
          <p>
            Let people follow your terminal as it happens. Stream a coding session,
            a walkthrough, or a terminal dashboard, using asciinema CLI 3 or newer.
          </p>
          <.code_with_copy>asciinema stream -r</.code_with_copy>
          <a href="https://docs.asciinema.org/getting-started/#live-streaming">Start a live stream</a>
        </div>
      </article>

      <article>
        <header>
          <span class="feature-number" aria-hidden="true">04</span>
          <h3>Embed the player</h3>
        </header>
        <div class="feature-content">
          <p>
            The player works on your own pages, too.
            Put a recording alongside the explanation in your docs, blog, or slides.
            You can embed it from here, or host the player and <code>.cast</code> file yourself.
          </p>
          <div class="feature-links">
            <a href="https://docs.asciinema.org/manual/server/embedding/">Embed from asciinema.org</a>
            <a href="https://docs.asciinema.org/manual/player/quick-start/">Use the standalone player</a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="home-open-source" aria-labelledby="open-source-title">
  <div class="container">
    <div class="open-source-layout">
      <h2 id="open-source-title">The project</h2>
      <div>
        <p>
          The CLI, web player, and server behind this site are separate pieces of free and open-source software.
          You can use them together or on their own.
        </p>
        <p>
          The recording format is documented, too, if you'd like to write your own tools for it.
          The server hosts recordings and relays live streams. You can run your own, too.
        </p>
        <div class="open-source-links">
          <a href="https://github.com/asciinema">Source code</a>
          <a href="https://docs.asciinema.org/manual/asciicast/v3/">Format specification</a>
          <a href="https://docs.asciinema.org/manual/server/self-hosting/">Run your own server</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section
  :if={
    @live_streams.items != [] || @featured_asciicasts.items != [] ||
      @popular_asciicasts.items != []
  }
  class="home-community"
  aria-label="On this server"
>
  <div class="container">
    <p class="home-eyebrow">On this server</p>
    <%= if length(@live_streams.items) > 0 do %>
      <div class="heading">
        <h2>Live streams</h2>
        <a :if={@live_streams.has_more} href={~p"/explore/streams/live"}>Browse all</a>
      </div>

      <div class="asciicast-list">
        <div :for={stream <- @live_streams.items}>
          {live_render(@conn, AsciinemaWeb.StreamCardLive,
            session: %{"stream_id" => stream.id, "show_visibility_badge" => false}
          )}
        </div>
      </div>
    <% end %>

    <%= if length(@featured_asciicasts.items) > 0 do %>
      <div class="heading">
        <h2>Featured recordings</h2>
        <a :if={@featured_asciicasts.has_more} href={~p"/explore/recordings/featured"}>
          Browse all
        </a>
      </div>

      <div class="asciicast-list">
        <div :for={asciicast <- @featured_asciicasts.items}>
          <RecordingHTML.card
            asciicast={asciicast}
            show_created_at={false}
            show_featured_badge={false}
          />
        </div>
      </div>
    <% end %>

    <%= if length(@popular_asciicasts.items) > 0 do %>
      <div class="heading">
        <h2>Popular recordings</h2>
        <a :if={@popular_asciicasts.has_more} href={~p"/explore/recordings/popular"}>
          Browse all
        </a>
      </div>

      <div class="asciicast-list">
        <div :for={asciicast <- @popular_asciicasts.items}>
          <RecordingHTML.card
            asciicast={asciicast}
            show_created_at={false}
            show_featured_badge={false}
          />
        </div>
      </div>
    <% end %>
  </div>
</section>

<script>
  window.addEventListener('load', async function() {
    const preference = document.querySelector('meta[name="color-scheme"]').content;
    const dark = preference === 'dark' ||
      (preference !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);

    await window.createPlayer(
      <%= safe_json(~p"/demo/homepage.cast") %>,
      document.getElementById('player'),
      {
        cols: 72,
        rows: 18,
        theme: dark ? 'asciinema-neo-dark' : 'asciinema-neo-light',
        preload: true,
        poster: 'npt:34.477',
        fit: 'width',
        speed: 1,
        boldIsBright: false,
        adaptivePalette: false,
        logger: console
      }
    );
  });
</script>
