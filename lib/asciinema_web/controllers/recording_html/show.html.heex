<section
  class="cinema"
  id="cinema"
  style={"height: #{cinema_height(@asciicast)}vw; max-height: 75vh"}
>
</section>

<div class="container medium-content">
  <div class="medium-header">
    <div class="content-sidebar-layout">
      <div>
        <span class="author-avatar">
          <.link href={author_profile_path(@asciicast)} title={author_username(@asciicast)}>
            <img src={author_avatar_url(@asciicast)} class="avatar" />
          </.link>
        </span>

        <h2>{title(@asciicast)}</h2>

        <small>
          by <.link href={author_profile_path(@asciicast)}>{author_username(@asciicast)}</.link>
          <.time_ago time={@asciicast.inserted_at} />
          <.visibility_badge
            :if={owned_by_current_user?(@asciicast, @conn)}
            visibility={@asciicast.visibility}
          />
          <.featured_badge :if={@asciicast.featured} />
        </small>
      </div>

      <div class="text-right actions">
        <button
          :if={@asciicast.visibility != :private}
          type="button"
          class="btn btn-sm btn-secondary"
          id="share-link"
          data-modal="share-modal"
        >
          <.share_mini_icon /> Share
        </button>

        <details class="dropdown">
          <summary class="btn btn-sm btn-secondary">
            <.download_mini_icon /> Download
          </summary>

          <div class="dropdown-menu">
            <button
              type="button"
              class="dropdown-item"
              id="download-link"
              data-modal="download-modal"
            >
              <strong>.{filename_ext(@asciicast)}</strong> - original recording
            </button>
            <.link href="#" class="dropdown-item" rel="nofollow" id="download-txt">
              <strong>.txt</strong> - plain text version
            </.link>
            <button type="button" class="dropdown-item" data-modal="gif-modal">
              <strong>.gif</strong> - animated GIF
            </button>
          </div>
        </details>

        <details :if={length(@actions) > 0} class="dropdown">
          <summary class="btn btn-sm btn-secondary">
            <.cog_8_tooth_mini_icon />
          </summary>

          <div class="dropdown-menu">
            <.link
              :if={:edit in @actions}
              href={~p"/a/#{@asciicast}/edit"}
              class="dropdown-item"
            >
              Settings
            </.link>

            <.link
              :if={:delete in @actions}
              href={~p"/a/#{@asciicast}"}
              class="dropdown-item text-danger"
              method="delete"
              data-confirm="Are you sure you want to delete this recording?"
            >
              Delete
            </.link>
          </div>
        </details>
      </div>
    </div>
  </div>

  <div class="medium-metadata">
    <div class="status-line">
      <span class="status-line-item">
        <.terminal_solid_icon /> <.env_info attrs={env_info_attrs(@asciicast)} />
      </span>

      <span class="status-line-item" title="Total views">
        <.eye_solid_icon /> {views_count(@asciicast)} views
      </span>
    </div>
  </div>

  <%= if desc = render_markdown(@asciicast.description) do %>
    <div class="medium-description prose">{desc}</div>
  <% end %>

  <div :if={length(@other_asciicasts.items) > 0} class="related-recordings">
    <div class="heading">
      <h2>
        More recordings by
        <a class="heading-value" href={author_profile_path(@asciicast)}>{author_username(
          @asciicast
        )}</a>
      </h2>
      <a :if={@other_asciicasts.has_more} href={~p"/~#{@asciicast.user}/recordings"}>
        Browse all
      </a>
    </div>

    <div class="asciicast-list">
      <div :for={asciicast <- @other_asciicasts.items}>
        <.card asciicast={asciicast} show_visibility_badge={@self} />
      </div>
    </div>
  </div>
</div>

<.share_modal asciicast={@asciicast} />
<.download_modal asciicast={@asciicast} />
<.gif_modal asciicast={@asciicast} />

<script>
  // @license magnet:?xt=urn:btih:8e4f440f4c65981c5bf93c76d35135ba5064d8b7&dn=apache-2.0.txt Apache-2.0
  window.addEventListener('load', async function() {
    const container = document.getElementById('cinema');
    const opts = <%= safe_json(player_opts(@asciicast, @player_opts)) %>;
    const viewCountUrl = <%= safe_json(@view_count_url) %>;

    const player = await window.createPlayer(
      <%= safe_json(player_src(@asciicast)) %>,
      container,
      {
        ...opts,
        fit: 'both',
        preload: true,
        logger: console
      }
    );

    player.addEventListener('metadata', ({ size }) => {
      if (size !== undefined) {
        container.style.height = window.cinemaHeight(size.cols, size.rows);
      }
    });

    if (viewCountUrl) {
      let counted = false;

      player.addEventListener('playing', () => {
        if (counted) return;

        counted = true;
        navigator.sendBeacon(viewCountUrl);
      });
    }
  });
  // @license-end
</script>
